# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Gnani API (Prisma STT + Timbre TTS) ---
# Key from https://app.gnani.ai/voice, sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Prisma language code. Docs: code-mixed English-Hindi is supported via en-IN (DECISIONS.md D-002).
STT_LANGUAGE=en-IN

# Timbre. Poorvi is the only Hinglish (hi-en) voice in the catalog; Hindi (hi-IN) voices include Nalini, Deepak.
TTS_VOICE=Poorvi
TTS_LANGUAGE=hi-en
TTS_SAMPLE_RATE=16000

# --- Evon v3.3 LLM (OpenAI-compatible /v1/chat/completions) ---
# Served from Kaggle by deploy/kaggle_evon.ipynb (docs/EVON_KAGGLE.md, D-027).
# Its last cell prints all three lines; the URL and key change every session.
EVON_BASE_URL=http://localhost:8001/v1
EVON_API_KEY=
EVON_MODEL=gnani-evon-v3.3

# --- App ---
DB_PATH=khatacall.db
# true = all three adapters faked: no network, no credits spent.
USE_FAKES=false
# true = real Prisma + Timbre, canned Evon replies. Useful until Evon is served (D-001).
FAKE_LLM=false
