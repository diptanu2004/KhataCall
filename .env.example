# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Gnani API (Prisma STT + Timbre TTS) ---
# Key from https://app.gnani.ai/voice, sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Prisma language code. Docs: code-mixed English-Hindi is supported via en-IN (DECISIONS.md D-002).
STT_LANGUAGE=en-IN

# Timbre. Voice names from the voice catalog (docs list e.g. Nalini, Kaveri, Deepak).
TTS_VOICE=Nalini
TTS_LANGUAGE=hi-en
TTS_SAMPLE_RATE=16000

# --- Evon v3.3 LLM (OpenAI-compatible /v1/chat/completions) ---
# Hosted endpoint (if Gnani provides one) or self-served (vLLM / llama-server). See DECISIONS.md D-001.
EVON_BASE_URL=http://localhost:8001/v1
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# --- App ---
DB_PATH=khatacall.db
# true = deterministic fakes, no network, no credits spent.
USE_FAKES=false
